<Application x:Class="RadeonTuner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RadeonTuner">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme Color -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ThemeForegroundColor">#1D1D1D</Color>
                    <SolidColorBrush x:Key="ThemeForegroundBrush">#1D1D1D</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundColor">#CECECE</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#CECECE</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundDarkColor">#AEAEAE</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundDarkBrush">#AEAEAE</SolidColorBrush>
                    <x:String x:Key="ThemeImageApps">/Assets/AppsDark.png</x:String>
                    <x:String x:Key="ThemeImageCheckmark">/Assets/CheckmarkDark.png</x:String>
                    <x:String x:Key="ThemeImageCross">/Assets/CrossDark.png</x:String>
                    <x:String x:Key="ThemeImageDisplay">/Assets/DisplayDark.png</x:String>
                    <x:String x:Key="ThemeImageDragDrop">/Assets/DragDropDark.png</x:String>
                    <x:String x:Key="ThemeImageExperimental">/Assets/ExperimentalDark.png</x:String>
                    <x:String x:Key="ThemeImageFans">/Assets/FansDark.png</x:String>
                    <x:String x:Key="ThemeImageGraphics">/Assets/GraphicsDark.png</x:String>
                    <x:String x:Key="ThemeImageInformation">/Assets/InformationDark.png</x:String>
                    <x:String x:Key="ThemeImageLink">/Assets/LinkDark.png</x:String>
                    <x:String x:Key="ThemeImageMultimedia">/Assets/MultimediaDark.png</x:String>
                    <x:String x:Key="ThemeImagePlus">/Assets/PlusDark.png</x:String>
                    <x:String x:Key="ThemeImagePower">/Assets/PowerDark.png</x:String>
                    <x:String x:Key="ThemeImageRemove">/Assets/RemoveDark.png</x:String>
                    <x:String x:Key="ThemeImageReset">/Assets/ResetDark.png</x:String>
                    <x:String x:Key="ThemeImageSettings">/Assets/SettingsDark.png</x:String>
                    <x:String x:Key="ThemeImageShield">/Assets/ShieldDark.png</x:String>
                    <x:String x:Key="ThemeImageShutdown">/Assets/ShutdownDark.png</x:String>
                    <x:String x:Key="ThemeImageTuning">/Assets/TuningDark.png</x:String>
                    <x:String x:Key="ThemeImageUnlink">/Assets/UnlinkDark.png</x:String>
                    <x:String x:Key="ThemeImageUpdate">/Assets/UpdateDark.png</x:String>
                    <x:String x:Key="ThemeImageVideocard">/Assets/VideocardDark.png</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ThemeForegroundColor">#F1F1F1</Color>
                    <SolidColorBrush x:Key="ThemeForegroundBrush">#F1F1F1</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundColor">#424242</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#424242</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundDarkColor">#303030</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundDarkBrush">#303030</SolidColorBrush>
                    <x:String x:Key="ThemeImageApps">/Assets/Apps.png</x:String>
                    <x:String x:Key="ThemeImageCheckmark">/Assets/Checkmark.png</x:String>
                    <x:String x:Key="ThemeImageCross">/Assets/Cross.png</x:String>
                    <x:String x:Key="ThemeImageDisplay">/Assets/Display.png</x:String>
                    <x:String x:Key="ThemeImageDragDrop">/Assets/DragDrop.png</x:String>
                    <x:String x:Key="ThemeImageExperimental">/Assets/Experimental.png</x:String>
                    <x:String x:Key="ThemeImageFans">/Assets/Fans.png</x:String>
                    <x:String x:Key="ThemeImageGraphics">/Assets/Graphics.png</x:String>
                    <x:String x:Key="ThemeImageInformation">/Assets/Information.png</x:String>
                    <x:String x:Key="ThemeImageLink">/Assets/Link.png</x:String>
                    <x:String x:Key="ThemeImageMultimedia">/Assets/Multimedia.png</x:String>
                    <x:String x:Key="ThemeImagePlus">/Assets/Plus.png</x:String>
                    <x:String x:Key="ThemeImagePower">/Assets/Power.png</x:String>
                    <x:String x:Key="ThemeImageRemove">/Assets/Remove.png</x:String>
                    <x:String x:Key="ThemeImageReset">/Assets/Reset.png</x:String>
                    <x:String x:Key="ThemeImageSettings">/Assets/Settings.png</x:String>
                    <x:String x:Key="ThemeImageShield">/Assets/Shield.png</x:String>
                    <x:String x:Key="ThemeImageShutdown">/Assets/Shutdown.png</x:String>
                    <x:String x:Key="ThemeImageTuning">/Assets/Tuning.png</x:String>
                    <x:String x:Key="ThemeImageUnlink">/Assets/Unlink.png</x:String>
                    <x:String x:Key="ThemeImageUpdate">/Assets/Update.png</x:String>
                    <x:String x:Key="ThemeImageVideocard">/Assets/Videocard.png</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- System Color -->
            <Color x:Key="SystemAccentColor">#DF2020</Color>
            <Color x:Key="SystemAccentColorDark1">#b81717</Color>
            <Color x:Key="SystemAccentColorDark2">#911111</Color>
            <Color x:Key="SystemAccentColorDark3">#690c0c</Color>
            <Color x:Key="SystemAccentColorLight1">#f52c2c</Color>
            <Color x:Key="SystemAccentColorLight2">#fb3c3c</Color>
            <Color x:Key="SystemAccentColorLight3">#fe5252</Color>

            <!-- Accent Color -->
            <Color x:Key="ApplicationAccentLightColor">#DF2020</Color>
            <SolidColorBrush x:Key="ApplicationAccentLightBrush">#DF2020</SolidColorBrush>
            <Color x:Key="ApplicationAccentDimColor">#b81717</Color>
            <SolidColorBrush x:Key="ApplicationAccentDimBrush">#b81717</SolidColorBrush>
            <Color x:Key="ApplicationAccentDarkColor">#911111</Color>
            <SolidColorBrush x:Key="ApplicationAccentDarkBrush">#911111</SolidColorBrush>
            <Color x:Key="ApplicationAccentVoidColor">#690c0c</Color>
            <SolidColorBrush x:Key="ApplicationAccentVoidBrush">#690c0c</SolidColorBrush>

            <!-- Basic Color -->
            <Color x:Key="ApplicationWhiteColor">#F1F1F1</Color>
            <SolidColorBrush x:Key="ApplicationWhiteBrush">#F1F1F1</SolidColorBrush>
            <Color x:Key="ApplicationBlackColor">#1D1D1D</Color>
            <SolidColorBrush x:Key="ApplicationBlackBrush">#1D1D1D</SolidColorBrush>
            <Color x:Key="ApplicationLightGrayColor">#CECECE</Color>
            <SolidColorBrush x:Key="ApplicationLightGrayBrush">#CECECE</SolidColorBrush>
            <Color x:Key="ApplicationDimGrayColor">#787878</Color>
            <SolidColorBrush x:Key="ApplicationDimGrayBrush">#787878</SolidColorBrush>
            <Color x:Key="ApplicationDarkGrayColor">#424242</Color>
            <SolidColorBrush x:Key="ApplicationDarkGrayBrush">#424242</SolidColorBrush>
            <Color x:Key="ApplicationVoidGrayColor">#2A2A2A</Color>
            <SolidColorBrush x:Key="ApplicationVoidGrayBrush">#2A2A2A</SolidColorBrush>

            <!-- Other Color -->
            <Color x:Key="ApplicationValidColor">#1EB955</Color>
            <SolidColorBrush x:Key="ApplicationValidBrush">#1EB955</SolidColorBrush>
            <Color x:Key="ApplicationInvalidColor">#CD1928</Color>
            <SolidColorBrush x:Key="ApplicationInvalidBrush">#CD1928</SolidColorBrush>
            <Color x:Key="ApplicationIgnoredColor">#EE8F3F</Color>
            <SolidColorBrush x:Key="ApplicationIgnoredBrush">#EE8F3F</SolidColorBrush>

            <!-- Templates -->
            <ControlTemplate x:Name="ListViewItemTemplateRound" TargetType="ListViewItem">
                <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SystemAccentColorDark1}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOverSelected">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SystemAccentColorDark1}"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOverPressed">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.40"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                                <Storyboard>
                                    <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="PressedSelected">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.40"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                                <Storyboard>
                                    <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter"/>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="DisabledStates">
                            <VisualState x:Name="Enabled"/>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.50"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ContentPresenter>
            </ControlTemplate>

            <ControlTemplate x:Key="ButtonTemplateHover" TargetType="Button">
                <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonForegroundPointerOver}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.40"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonBorderBrushPressed}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}"/>
                                </VisualState.Setters>
                                <Storyboard>
                                    <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.50"/>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundDisabled}"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ContentPresenter>
            </ControlTemplate>

            <!-- Elements -->
            <Style x:Name="ApplicationListView" TargetType="ListView">
                <Setter Property="ItemContainerStyle" Value="{ThemeResource ApplicationListViewItem}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Name="ApplicationListViewDark" TargetType="ListView">
                <Setter Property="ItemContainerStyle" Value="{ThemeResource ApplicationListViewItemDark}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Name="ApplicationListViewItem" TargetType="ListViewItem">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{ThemeResource ThemeBackgroundBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{ThemeResource ListViewItemTemplateRound}"/>
            </Style>

            <Style x:Name="ApplicationListViewItemDark" TargetType="ListViewItem">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{ThemeResource ThemeBackgroundDarkBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{ThemeResource ListViewItemTemplateRound}"/>
            </Style>

            <Style x:Name="ApplicationSlider" TargetType="Slider">
                <!-- UseLayoutRounding fixes 125% DPI crash -->
                <Setter Property="UseLayoutRounding" Value="False"/>
            </Style>

            <Style x:Name="ApplicationComboBox" TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Name="ApplicationButton" TargetType="Button">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Template" Value="{ThemeResource ButtonTemplateHover}"/>
            </Style>

            <Style x:Name="ApplicationButtonImage" TargetType="Button">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Template" Value="{ThemeResource ButtonTemplateHover}"/>
            </Style>

            <Style x:Name="ApplicationTextBox" TargetType="TextBox">
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Name="ApplicationTextBoxNoHit" TargetType="TextBox">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Name="ApplicationTextBoxReadOnly" TargetType="TextBox">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>